# Native Docker/LXC kernel capabilities, applied after stage1.config.
# Host cgroup mounts, limits, network rules and daemons stay externally managed.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_FHANDLE=y

# Existing bridge/veth, IPv4 NAT and filesystems remain built in.
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NF_NAT_IPV6=y
CONFIG_IP6_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE_IPV6=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# Preserve the selected host networking and I/O behavior.
# CONFIG_BRIDGE_NETFILTER is not set
# CONFIG_BLK_DEV_THROTTLING is not set

# Keep stock tree-owned drivers built in; optional LKM support stays enabled.
CONFIG_QCA_CLD_WLAN=y
CONFIG_MSM_11AD=y
CONFIG_INCREMENTAL_FS=y
CONFIG_SOFT_WATCHDOG=y
